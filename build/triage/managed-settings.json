{
  "disableAllHooks": true,
  "apiKeyHelper": "/usr/local/bin/triage-api-key",
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Bash(kubectl get *)",
      "Bash(kubectl describe *)",
      "Bash(kubectl logs *)",
      "Bash(kubectl top *)",
      "Bash(kubectl events *)",
      "Bash(flux get *)",
      "Bash(triage-query vm *)",
      "Bash(triage-query vm-lt *)",
      "Bash(triage-query loki *)"
    ],
    "deny": [
      "WebFetch",
      "WebSearch",
      "Edit",
      "Write",
      "NotebookEdit",
      "Bash(helm *)",
      "Bash(kubectl get secret*)",
      "Bash(kubectl get secrets*)",
      "Bash(kubectl describe secret*)",
      "Bash(kubectl * secret*)",
      "Bash(kubectl exec *)",
      "Bash(kubectl port-forward *)",
      "Bash(kubectl cp *)",
      "Bash(kubectl proxy*)",
      "Bash(kubectl debug *)",
      "Bash(kubectl * --raw*)",
      "Bash(kubectl * --kubeconfig*)",
      "Bash(kubectl * --token*)",
      "Bash(kubectl * --server*)",
      "Bash(kubectl * -s*)",
      "Bash(kubectl * --as*)",
      "Bash(kubectl * --user*)",
      "Bash(kubectl * --context*)",
      "Bash(kubectl * --cluster*)",
      "Bash(kubectl * --certificate-authority*)",
      "Bash(kubectl * --client-certificate*)",
      "Bash(kubectl * --client-key*)",
      "Bash(kubectl * --insecure-skip-tls-verify*)",
      "Bash(kubectl * --tls-server-name*)",
      "Bash(kubectl * --cache-dir*)",
      "Bash(kubectl * --profile*)",
      "Bash(kubectl * -f*)",
      "Bash(kubectl * --filename*)",
      "Bash(kubectl * -k*)",
      "Bash(kubectl * --kustomize*)",
      "Bash(kubectl * --password*)",
      "Bash(kubectl * --username*)",
      "Bash(kubectl *jsonpath-file*)",
      "Bash(kubectl *template-file*)",
      "Bash(kubectl *templatefile*)",
      "Bash(kubectl *columns-file*)",
      "Bash(flux * --kubeconfig*)",
      "Bash(flux * --token*)",
      "Bash(flux * --server*)",
      "Bash(flux * --as*)",
      "Bash(flux * --user*)",
      "Bash(flux * --context*)",
      "Bash(flux * --cluster*)",
      "Bash(flux * --certificate-authority*)",
      "Bash(flux * --client-certificate*)",
      "Bash(flux * --client-key*)",
      "Bash(flux * --insecure-skip-tls-verify*)",
      "Bash(flux * --tls-server-name*)",
      "Bash(flux * --cache-dir*)",
      "Read(//var/run/secrets/**)",
      "Read(//proc/**)",
      "Read(//etc/triage/**)",
      "Bash(git *)",
      "Bash(curl *)",
      "Bash(wget *)"
    ]
  }
}
