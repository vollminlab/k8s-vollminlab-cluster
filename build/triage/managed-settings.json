{
  "disableAllHooks": true,
  "apiKeyHelper": "/usr/local/bin/triage-api-key",
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Bash(kubectl get *)",
      "Bash(kubectl describe *)",
      "Bash(kubectl logs *)",
      "Bash(kubectl top *)",
      "Bash(kubectl events *)",
      "Bash(flux get *)",
      "Bash(curl -s http://victoria-metrics-single-server.monitoring.svc:8428/*)",
      "Bash(curl -s 'http://victoria-metrics-single-server.monitoring.svc:8428/*)",
      "Bash(curl -s http://victoria-metrics-lt-server.monitoring.svc:8428/*)",
      "Bash(curl -s 'http://victoria-metrics-lt-server.monitoring.svc:8428/*)",
      "Bash(curl -s http://loki.monitoring.svc:3100/*)",
      "Bash(curl -s 'http://loki.monitoring.svc:3100/*)"
    ],
    "deny": [
      "WebFetch",
      "WebSearch",
      "Edit",
      "Write",
      "NotebookEdit",
      "Bash(helm *)",
      "Bash(kubectl get secret*)",
      "Bash(kubectl get secrets*)",
      "Bash(kubectl describe secret*)",
      "Bash(kubectl exec *)",
      "Bash(kubectl port-forward *)",
      "Bash(kubectl cp *)",
      "Bash(kubectl proxy*)",
      "Bash(kubectl debug *)",
      "Read(//var/run/secrets/**)",
      "Read(//proc/**)",
      "Read(//etc/triage/**)",
      "Bash(git *)",
      "Bash(curl * -o*)",
      "Bash(curl * --output*)",
      "Bash(curl * -O*)",
      "Bash(curl * -d*)",
      "Bash(curl * --data*)",
      "Bash(curl * -T*)",
      "Bash(curl * --upload*)",
      "Bash(curl * -K*)",
      "Bash(curl * --config*)",
      "Bash(curl * -D*)",
      "Bash(curl * --dump-header*)",
      "Bash(curl * --trace*)",
      "Bash(curl * --stderr*)",
      "Bash(curl * -c*)",
      "Bash(curl * --cookie-jar*)",
      "Bash(curl * --libcurl*)",
      "Bash(curl * -F*)",
      "Bash(curl * --form*)",
      "Bash(curl * --etag-save*)",
      "Bash(curl * --hsts*)",
      "Bash(curl * --alt-svc*)"
    ]
  }
}
